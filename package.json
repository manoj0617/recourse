{
  "name": "recourse",
  "version": "0.1.0",
  "private": true,
  "description": "An adjudication layer for agent-initiated payments. Implements AP2 v0.2 mandate constraint evaluation and rules on whether a completed purchase satisfied what was authorized.",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "demo": "tsx src/scenarios/cli.ts",
    "eval": "tsx evals/run.ts",
    "keygen": "tsx src/crypto/keygen-cli.ts"
  },
  "dependencies": {
    "@noble/ed25519": "^2.1.0",
    "@noble/hashes": "^1.5.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "razorpay": "^2.9.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
