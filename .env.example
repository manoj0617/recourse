# Copy to .env. Nothing here is read at import time; every module takes its configuration as an
# argument, so tests and the eval harness never depend on this file existing.

# --- conformance judge -----------------------------------------------------------------------
# Any OpenAI-compatible endpoint. Groq is the default because it is fast and has a free tier;
# Cerebras and Mistral work by changing these three values and nothing else.
JUDGE_BASE_URL=https://api.groq.com/openai/v1
JUDGE_API_KEY=
JUDGE_MODEL=llama-3.3-70b-versatile

# live   every call hits the provider
# record cache misses hit the provider and are written to JUDGE_CACHE_PATH
# replay the cache only; a miss is an error and nothing reaches the network
JUDGE_MODE=record
JUDGE_CACHE_PATH=data/judge-cache.json

# Rulings at or below this confidence escalate to a human instead of deciding.
JUDGE_CONFIDENCE_THRESHOLD=0.6

# --- payment rail ----------------------------------------------------------------------------
# Test mode only. Test keys start rzp_test_ and need no KYC.
RAZORPAY_KEY_ID=rzp_test_
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- local state -----------------------------------------------------------------------------
# The Ed25519 signing key is generated here on first run if absent. It is a file on disk and the
# README says so; this is not key custody and does not pretend to be.
RECOURSE_KEY_PATH=keys/issuer.json
RECOURSE_LEDGER_PATH=data/ledger.jsonl
PORT=3000
